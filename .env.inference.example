# Inference environment: run onehop / multihop / chat against an existing project_dir

# ---- LLM service ----
LLM_MODEL_KEY=replace-me
LLM_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max
LLM_API_TIMEOUT_SECONDS=180
LLM_API_CLIENT_MAX_RETRIES=0
# LLM_API_PROVIDER=dashscope
# LLM_API_ENABLE_THINKING=false
# LLM_API_BASE=  # alias of LLM_MODEL_URL

# ---- Embedding service ----
EMBEDDING_MODEL_KEY=replace-me
EMBEDDING_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=256
# EMBEDDING_PROVIDER=dashscope
EMBEDDING_FUNC_MAX_ASYNC=8
EMBEDDING_BATCH_NUM=10
# EMBEDDING_TIMEOUT_SECONDS=180
# External API only. MEP local vLLM forces these to 0.
# EMBEDDING_SEND_DIMENSIONS=1
# EMBEDDING_REQUEST_DIMENSIONS=1

# ---- Rerank service ----
RERANK_MODEL_KEY=replace-me
RERANK_MODEL_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RERANK_MODEL=qwen3-rerank
# RERANK_TIMEOUT_SECONDS=180

# ---- TLS (verification defaults to disabled for enterprise MITM proxies) ----
# RAGENT_SSL_VERIFY=0
# Set RAGENT_SSL_VERIFY=1 to enable certificate verification.
# If LiteLLM aiohttp transport still reports SSL errors, set:
# DISABLE_AIOHTTP_TRANSPORT=True

# ---- Runtime, dotenv, logging ----
# RAGENT_RUNTIME_ENV=local
# RAGENT_ENV=local
# RAGENT_SKIP_DOTENV=0
# RAGENT_LOG_LEVEL=INFO
# WORKSPACE=
# VERBOSE=false
# RAG_TRACE_MODEL_CALLS=0
# RAG_VERBOSE_ERRORS=0
# LITELLM_LOG=WARNING

# ---- Strict offline (local only; MEP sets these in process.py) ----
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# TOKENIZERS_PARALLELISM=false

# ---- Optional KG backends (Neo4j / Milvus only) ----
# RAGENT_KG_CONFIG_FILE=
# NEO4J_CONFIG_FILE=
# NEO4J_URI=
# NEO4J_WORKSPACE=
# MILVUS_CONFIG_FILE=
# MILVUS_URI=
# MILVUS_WORKSPACE=

# ---- Concurrency and token limits ----
MAX_ASYNC=4
MAX_TOKENS=32000

# ---- Retrieval and answer defaults ----
TOP_K=40
CHUNK_TOP_K=10
MAX_ENTITY_TOKENS=10000
MAX_RELATION_TOKENS=10000
MAX_TOTAL_TOKENS=32000
HISTORY_TURNS=0
RELATED_CHUNK_NUMBER=10
COSINE_THRESHOLD=0.2
ENABLE_RERANK=true
RAG_ANSWER_PROMPT_MODE=single_prompt

# ---- Query cache (0 disables TTL / LRU pruning) ----
QUERY_CACHE_TTL_SECONDS=0
QUERY_CACHE_MAX_ENTRIES=0
# QUERY_CACHE_BACKEND=sqlite

# ---- Startup healthcheck ----
MODEL_STARTUP_CHECK_ENABLED=1
MODEL_STARTUP_CHECK_TIMEOUT_SECONDS=30

# ---- Keyword fallback (GLiNER; used when LLM keyword extraction is unavailable) ----
# RAG_KEYWORD_FALLBACK_ENABLED=true
# RAG_KEYWORD_FALLBACK_MODEL=mep/component_deps/models/keyword_extraction/knowledgator-gliner-x-small
# RAG_KEYWORD_FALLBACK_DEVICE=cpu
# RAG_KEYWORD_FALLBACK_THRESHOLD=0.35
# RAG_KEYWORD_FALLBACK_MAX_KEYWORDS=12
# RAG_KEYWORD_FALLBACK_LABELS=person,organization,location,event,concept
# RAG_KEYWORD_FALLBACK_WARMUP_TEXT=我已经是个成年男人了，但是下午多喝了一听含糖饮料(330ml)，我先 中速步行30 分钟，再爬楼多久能补回来？
# RAG_KEYWORD_FALLBACK_PRELOAD=false
# RAGENT_MEP_PRELOAD_KEYWORD_FALLBACK=1
