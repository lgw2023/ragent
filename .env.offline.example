# Copy this file to .env on the target server, then fill in the model endpoint
# URLs and keys that are reachable from that server.

# Remote OpenAI-compatible model services. Keep these pointed at the only
# network endpoints allowed in the target environment.
LLM_MODEL=qwen3-32b
LLM_MODEL_URL=http://127.0.0.1:8000/compatible-mode/v1
LLM_MODEL_KEY=replace-me
LLM_API_TIMEOUT_SECONDS=120
LLM_API_CLIENT_MAX_RETRIES=0
# LLM_API_PROVIDER=custom_openai

EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_MODEL_URL=http://127.0.0.1:8000/compatible-mode/v1
EMBEDDING_MODEL_KEY=replace-me
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_PROVIDER=custom_openai
EMBEDDING_FUNC_MAX_ASYNC=8
EMBEDDING_BATCH_NUM=10

RERANK_MODEL=qwen3-rerank
RERANK_MODEL_URL=http://127.0.0.1:8000/compatible-api/v1/reranks
RERANK_MODEL_KEY=replace-me

IMAGE_MODEL=qwen3-vl-flash
IMAGE_MODEL_URL=http://127.0.0.1:8000/compatible-mode/v1
IMAGE_MODEL_KEY=replace-me
IMAGE_MODEL_TIMEOUT=300
IMAGE_DESCRIPTION_MODE=single_multimodal

# MinerU offline local models. tools/bootstrap_offline_runtime.sh rewrites
# .runtime/mineru.json with absolute paths for the current server.
MINERU_PARSE_MODE=pipeline
MINERU_PIPELINE_METHOD=txt
MINERU_HYBRID_METHOD=auto
MINERU_VLM_BACKEND=auto
MINERU_MODEL_SOURCE=local
MINERU_TOOLS_CONFIG_JSON=.runtime/mineru.json

# Force common model loaders to stay offline.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# Concurrency & token limits
MAX_ASYNC=4
MAX_TOKENS=32000
MAX_PARALLEL_INSERT=2

# Chunking & entity extraction
num_chars_of_front=512
num_chars_of_behind=512
chunk_size=1024
overlap_size=128
ENTITY_EXTRACT_GLEANING_LEVEL=1
MAX_GLEANING=1
FORCE_LLM_SUMMARY_ON_MERGE=4
RAG_MD_SPLIT_MODE=parser

# Retrieval defaults
TOP_K=40
CHUNK_TOP_K=10
MAX_ENTITY_TOKENS=10000
MAX_RELATION_TOKENS=10000
MAX_TOTAL_TOKENS=32000
RELATED_CHUNK_NUMBER=10
COSINE_THRESHOLD=0.2
MAX_GRAPH_NODES=1000
SUMMARY_LANGUAGE=English

# Build / query runtime
MODEL_STARTUP_CHECK_ENABLED=1
MODEL_STARTUP_CHECK_TIMEOUT_SECONDS=30
ENABLE_RERANK=true
RAG_ANSWER_PROMPT_MODE=single_prompt
RAG_INSERT_BATCH_SIZE=all
RAG_INSERT_HARD_TIMEOUT=0
RAG_INSERT_TIMEOUT_SECONDS=3600
RAG_INSERT_TIMEOUT_MAX_SECONDS=14400
RAG_INSERT_RETRIES=2
RAG_INSERT_TIMEOUT_BACKOFF=1.8
RAG_INDEX_TIMEOUT_SECONDS=3600
RAG_PROGRESS_BAR=1

# Query cache (0 disables TTL / LRU pruning)
QUERY_CACHE_TTL_SECONDS=0
QUERY_CACHE_MAX_ENTRIES=0

# Keyword fallback (optional; useful when LLM is unavailable)
# RAG_KEYWORD_FALLBACK_ENABLED=true
# RAG_KEYWORD_FALLBACK_MODEL=/path/to/gliner-model
# RAG_KEYWORD_FALLBACK_DEVICE=cpu
