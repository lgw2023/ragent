# Copy this file to .env on the target server, then fill in the model endpoint
# URLs and keys that are reachable from that server.

# ---- LLM service ----
LLM_MODEL=qwen3-32b
LLM_MODEL_URL=http://127.0.0.1:8000/compatible-mode/v1
LLM_MODEL_KEY=replace-me
LLM_API_TIMEOUT_SECONDS=120
LLM_API_CLIENT_MAX_RETRIES=0
# LLM_API_PROVIDER=custom_openai
# LLM_API_ENABLE_THINKING=false
# LLM_API_BASE=  # alias of LLM_MODEL_URL

# ---- Embedding service ----
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_MODEL_URL=http://127.0.0.1:8000/compatible-mode/v1
EMBEDDING_MODEL_KEY=replace-me
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_PROVIDER=custom_openai
EMBEDDING_FUNC_MAX_ASYNC=8
EMBEDDING_BATCH_NUM=10
# EMBEDDING_TIMEOUT_SECONDS=180
# External API only. MEP local vLLM forces these to 0.
# EMBEDDING_SEND_DIMENSIONS=1
# EMBEDDING_REQUEST_DIMENSIONS=1

# ---- Rerank service ----
RERANK_MODEL=qwen3-rerank
RERANK_MODEL_URL=http://127.0.0.1:8000/compatible-api/v1/reranks
RERANK_MODEL_KEY=replace-me
# RERANK_TIMEOUT_SECONDS=180

# ---- Image description service ----
IMAGE_MODEL=qwen3-vl-flash
IMAGE_MODEL_URL=http://127.0.0.1:8000/compatible-mode/v1
IMAGE_MODEL_KEY=replace-me
IMAGE_MODEL_TIMEOUT=300
IMAGE_DESCRIPTION_MODE=single_multimodal

# ---- Runtime, dotenv, logging ----
# RAGENT_RUNTIME_ENV=local
# RAGENT_ENV=local
# RAGENT_SKIP_DOTENV=0
# RAGENT_LOG_LEVEL=INFO
# WORKSPACE=
# VERBOSE=false
# RAG_TRACE_MODEL_CALLS=0
# RAG_VERBOSE_ERRORS=0
# LITELLM_LOG=WARNING

# ---- Strict offline (required for air-gapped servers) ----
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# ---- Optional KG backends (Neo4j / Milvus only) ----
# RAGENT_KG_CONFIG_FILE=
# NEO4J_CONFIG_FILE=
# NEO4J_URI=
# NEO4J_WORKSPACE=
# MILVUS_CONFIG_FILE=
# MILVUS_URI=
# MILVUS_WORKSPACE=

# ---- Concurrency and token limits ----
MAX_ASYNC=4
MAX_TOKENS=32000
MAX_PARALLEL_INSERT=2

# ---- Chunking and entity extraction ----
num_chars_of_front=512
num_chars_of_behind=512
chunk_size=1024
overlap_size=128
ENTITY_EXTRACT_GLEANING_LEVEL=1
MAX_GLEANING=1
FORCE_LLM_SUMMARY_ON_MERGE=4
RAG_MD_SPLIT_MODE=parser

# ---- Retrieval defaults ----
TOP_K=40
CHUNK_TOP_K=10
MAX_ENTITY_TOKENS=10000
MAX_RELATION_TOKENS=10000
MAX_TOTAL_TOKENS=32000
# HISTORY_TURNS=0
RELATED_CHUNK_NUMBER=10
COSINE_THRESHOLD=0.2
MAX_GRAPH_NODES=1000
SUMMARY_LANGUAGE=English

# ---- Build, insert, startup healthcheck ----
MODEL_STARTUP_CHECK_ENABLED=1
MODEL_STARTUP_CHECK_TIMEOUT_SECONDS=30
ENABLE_RERANK=true
RAG_ANSWER_PROMPT_MODE=single_prompt
RAG_INSERT_BATCH_SIZE=all
RAG_INSERT_HARD_TIMEOUT=0
RAG_INSERT_TIMEOUT_SECONDS=3600
RAG_INSERT_TIMEOUT_MAX_SECONDS=14400
RAG_INSERT_RETRIES=2
RAG_INSERT_TIMEOUT_BACKOFF=1.8
RAG_INDEX_TIMEOUT_SECONDS=3600
RAG_PROGRESS_BAR=1
# RAG_INSERT_TRACE=0

# ---- Progress estimate tuning ----
# MD_PROGRESS_PARSE_ESTIMATE_SECONDS=45
# KG_PROGRESS_INIT_ESTIMATE_SECONDS=8
# KG_PROGRESS_UNIT_ESTIMATE_SECONDS=35
# CSV_SCAN_ESTIMATE_SECONDS=2
# CSV_INGEST_ESTIMATE_SECONDS=8

# ---- Query cache (0 disables TTL / LRU pruning) ----
QUERY_CACHE_TTL_SECONDS=0
QUERY_CACHE_MAX_ENTRIES=0
# QUERY_CACHE_BACKEND=sqlite

# ---- MinerU parsing ----
# tools/bootstrap_offline_runtime.sh rewrites .runtime/mineru.json with absolute paths.
MINERU_PARSE_MODE=pipeline
MINERU_PIPELINE_METHOD=txt
MINERU_HYBRID_METHOD=auto
MINERU_VLM_BACKEND=auto
MINERU_MODEL_SOURCE=local
MINERU_TOOLS_CONFIG_JSON=.runtime/mineru.json
# MINERU_VLM_SERVER_URL=http://127.0.0.1:30000
# MINERU_VLM_MODEL_PATH=/absolute/path/to/mineru-vlm

# ---- Wide-table import (optional) ----
# WIDE_TABLE_SHEET_NAME=0
# WIDE_TABLE_ENTITY_NAME_COLUMN=entity_name
# WIDE_TABLE_ENTITY_TYPE=product
# WIDE_TABLE_EXCLUDED_COLUMNS=id,created_at
# WIDE_TABLE_FEATURE_COLUMNS=price,stock
# WIDE_TABLE_INCLUDE_NULL_VALUES=false

# ---- Keyword fallback (GLiNER; useful when LLM is unavailable) ----
# RAG_KEYWORD_FALLBACK_ENABLED=true
# RAG_KEYWORD_FALLBACK_MODEL=mep/component_deps/models/keyword_extraction/knowledgator-gliner-x-small
# RAG_KEYWORD_FALLBACK_DEVICE=cpu
# RAG_KEYWORD_FALLBACK_THRESHOLD=0.35
# RAG_KEYWORD_FALLBACK_MAX_KEYWORDS=12
# RAG_KEYWORD_FALLBACK_LABELS=person,organization,location,event,concept
# RAG_KEYWORD_FALLBACK_WARMUP_TEXT=我已经是个成年男人了，但是下午多喝了一听含糖饮料(330ml)，我先 中速步行30 分钟，再爬楼多久能补回来？
# RAG_KEYWORD_FALLBACK_PRELOAD=false
# RAGENT_MEP_PRELOAD_KEYWORD_FALLBACK=1
